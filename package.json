{
  "name": "claude-workflow-kit",
  "version": "0.1.0",
  "description": "A deterministic ticket-readiness linter plus Claude Code commands for refining tickets and turning acceptance criteria into tests.",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/cli.ts tickets/*.md",
    "mutation-check": "python3 scripts/mutation-check.py",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,yml}": "prettier --write"
  }
}
